# Gentleman Guardian Angel - La Fábrica IA
# Provider: opencode CLI rutea a través del modelo configurado en
# /home/rafael/.config/opencode/opencode.json (cuenta MiniMax plan,
# no requiere API key — el opencode CLI ya está autenticado).
PROVIDER="opencode:minimax-coding-plan/MiniMax-M3"

# Cubrir todos los lenguajes de La Fábrica
FILE_PATTERNS="*.go,*.js,*.jsx,*.tsx,*.ts,*.php,*.sql,*.sh"

# Excluir dependencias y builds
EXCLUDE_PATTERNS="node_modules,vendor,.git,dist,build,*.test.go,*.spec.js,*.d.ts"

# Estándares de La Fábrica
RULES_FILE="CODING_STANDARDS.md"

STRICT_MODE="true"
TIMEOUT="180"
