# Required environment variables for CRM_ByBusiness
# Copy this file to .env.local (dev) or .env.production and fill in values.
# Missing any of these will cause the app to throw at startup.

VITE_N8N_URL=https://n8n.ia-bybusiness.online/webhook
VITE_REPUTATION_API_URL=https://n8n.ia-bybusiness.online/webhook/crm-reputacion-proxy
VITE_N8N_AUSENCIAS_URL=https://n8n.ia-bybusiness.online/webhook/crm-ausencias
VITE_N8N_GESTIONES_URL=https://n8n.ia-bybusiness.online/webhook/crm-ausencia-gestiones

# Frontend error reporting (n8n webhook)
# Production: https://n8n.ia-bybusiness.online/webhook/crm-frontend-error
VITE_FRONTEND_ERROR_WEBHOOK=
VITE_APP_VERSION=
