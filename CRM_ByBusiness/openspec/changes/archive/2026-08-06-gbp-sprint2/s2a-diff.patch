+def _extract_descripcion(page):
+    """Multi-fallback descripcion extraction. Returns (value, strategy_used)."""
+    # Strategy 1: ARIA / semantic
+    for sel in [
+        "[aria-label*='descripci\xc3\xb3n' i]",
+        "[aria-label*='Description' i]",
+        "[role='region'][aria-label*='descrip' i]",
+    ]:
+        try:
+            el = page.locator(sel).first
+            if el.is_visible(timeout=2000):
+                text = el.inner_text(timeout=2000).strip()
+                if text and len(text) >= 20:
+                    cleaned_lines = []
+                    for line in text.split("\n"):
+                        line = line.strip()
+                        if not line:
+                            continue
+                        if any(s in line for s in SKIP_PHRASES):
+                            continue
+                        if any(pt in line for pt in PRIVATE_TERMS):
+                            continue
+                        if line and len(line) > 10:
+                            cleaned_lines.append(line)
+                    if cleaned_lines:
+                        return " ".join(cleaned_lines)[:500], "aria"
+        except Exception:
+            continue
+
+    # Strategy 2: CSS classes (Google rotates these monthly)
+    for sel in [
+        ".section-hero-description",
+        "div[role='region'] + div p",
+        "div.WeS02d",
+        ".WeS02d",
+        "[class*='descripcion']",
+        "[class*='description']",
+    ]:
+        try:
+            el = page.locator(sel).first
+            if el.is_visible(timeout=2000):
+                text = el.inner_text(timeout=2000).strip()
+                if text and len(text) >= 20:
+                    cleaned_lines = []
+                    for line in text.split("\n"):
+                        line = line.strip()
+                        if not line:
+                            continue
+                        if any(s in line for s in SKIP_PHRASES):
+                            continue
+                        if any(pt in line for pt in PRIVATE_TERMS):
+                            continue
+                        if line and len(line) > 10:
+                            cleaned_lines.append(line)
+                    if cleaned_lines:
+                        return " ".join(cleaned_lines)[:500], "css"
+        except Exception:
+            continue
+
+    # Strategy 3: body-text regex fallback
+    try:
+        body = page.locator("body").inner_text()
+        m = re.search(r"(?i)descripci[oó]n\s*[:\-_]?\s*(.{20,500}?)", body)
+        if m:
+            candidate = m.group(1).strip()
+            if candidate and not any(s.lower() in candidate.lower() for s in SKIP_PHRASES):
+                if not any(pt.lower() in candidate.lower() for pt in PRIVATE_TERMS):
+                    return candidate[:500], "regex"
+    except Exception:
+        pass
+
+    sys.stderr.write("[gbp_scraper] descripcion: all_strategies_failed\n")
+    return None, "none"
+
