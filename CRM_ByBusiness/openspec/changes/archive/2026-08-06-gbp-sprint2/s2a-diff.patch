+def _extract_reviews_count(page):
+    """Multi-fallback reviews_count extraction. Returns (count, strategy_used)."""
+    # Strategy 1: ARIA labels containing reseñas/reviews/opiniones
+    for sel in [
+        "[aria-label*='rese\xc3\xb1a' i]",
+        "[aria-label*='reviews' i]",
+        "[aria-label*='opiniones' i]",
+        "[aria-label*='rese\xc3\xb1as' i]",
+    ]:
+        try:
+            el = page.locator(sel).first
+            if el.is_visible(timeout=2000):
+                lbl = el.get_attribute("aria-label") or ""
+                m = re.search(r"(\d+)\s*rese\xc3\xb1as?", lbl, re.IGNORECASE)
+                if not m:
+                    m = re.search(r"(\d+)\s*reviews?", lbl, re.IGNORECASE)
+                if not m:
+                    m = re.search(r"(\d+)\s*opiniones?", lbl, re.IGNORECASE)
+                if m:
+                    count = int(m.group(1))
+                    if count > 0:
+                        return count, "aria"
+        except Exception:
+            continue
+
+    # Strategy 2: img role=img with star label (existing pattern)
+    for sel in [
+        "img[role='img'][aria-label*='estrel' i]",
+        "img[role='img'][aria-label*='star' i]",
+        "[role='img'][aria-label*='estrel' i]",
+        "[role='img'][aria-label*='star' i]",
+    ]:
+        try:
+            el = page.locator(sel).first
+            if el.is_visible(timeout=2000):
+                lbl = el.get_attribute("aria-label") or ""
+                m = re.search(r"(\d+)\s*rese\xc3\xb1as?", lbl, re.IGNORECASE)
+                if m:
+                    return int(m.group(1)), "css"
+        except Exception:
+            continue
+
+    # Strategy 3: body-text regex fallback
+    try:
+        body = page.locator("body").inner_text()
+        for pat in [
+            r"(\d+)\s*rese\xc3\xb1as?",
+            r"(\d+)\s*reviews?",
+            r"(\d+)\s*opiniones?",
+        ]:
+            m = re.search(pat, body, re.IGNORECASE)
+            if m:
+                count = int(m.group(1))
+                if count > 0:
+                    return count, "regex"
+    except Exception:
+        pass
+
+    sys.stderr.write("[gbp_scraper] reviews_count: all_strategies_failed\n")
+    return 0, "none"
