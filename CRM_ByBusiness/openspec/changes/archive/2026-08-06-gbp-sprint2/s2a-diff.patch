+def _extract_atributos(page):
+    """Multi-fallback atributos extraction. Returns (count, strategy_used)."""
+    attr_indicators = [
+        "se identifica", "propietarias", "mujeres", "hombres",
+        "acceso para sillas", "aparcamiento adaptado", "accesibilidad",
+        "reservas", "reserva", "domicilio", "recogida",
+        "terraza", "mascotas", "wi-fi", "wifi", "comida para llevar",
+        "entrega a domicilio", "vegetariano", "vegano", "sin gluten",
+        "desayuno", "almuerzo", "cena", "caf\xc3\xa9", "bar", "restaurante",
+        "gama", "precio", "veterano", "empresa peque\xc3\xb1a",
+        "family-friendly", "children", "kids", "highchair",
+        "gender-neutral", "lgbtq", "owned by", "women-owned",
+    ]
+    skip_words = [
+        "A\xc3\xb1adir", "Escribir", "Sugerir", "Guardar", "Compartir", "Cercano",
+        "Tel\xc3\xa9fono", "Direcci\xc3\xb3n", "C\xc3\xb3mo llegar", "Ver fotos", "Rese\xc3\xb1a",
+        "Fotos y v\xc3\xaddeos", "A\xc3\xb1adir fotos", "Mostrar", "Ocultar",
+        "Iniciar sesi\xc3\xb3n", "vista limitada", "Google Maps", "Maps",
+        "T\xc3\xa9rminos", "Privacidad", "Restaurantes", "Hoteles", "Bares",
+        "Cafeter\xc3\xadas", "Qu\xc3\xa9 hacer", "Aparcamientos", "Farmacias",
+        "Cajeros", "Transporte", "Descarga",
+    ]
+
+    # Strategy 1: semantic selectors (data-attr-id, aria-label, .YDINU buttons)
+    try:
+        count = 0
+        chips = page.locator("[data-attr-id]")
+        count += chips.count()
+        aria_atrs = page.locator("[aria-label*='atributo' i]")
+        count += aria_atrs.count()
+        ydinu_btns = page.locator(".YDINU button")
+        count += ydinu_btns.count()
+        if count >= 3:
+            return min(count, 15), "aria"
+    except Exception:
+        pass
+
+    # Strategy 2: CSS class patterns (broader fallback)
+    try:
+        body = page.locator("body").inner_text()
+        lines = body.split("\n")
+        attr_count = 0
+        for line in lines:
+            line = line.strip()
+            if not line or len(line) < 5 or len(line) > 120:
+                continue
+            if any(sw.lower() in line.lower() for sw in skip_words):
+                continue
+            line_lower = line.lower()
+            matches = sum(1 for ind in attr_indicators if ind.lower() in line_lower)
+            if matches > 0:
+                attr_count += 1
+        if attr_count >= 3:
+            return min(attr_count, 15), "css"
+    except Exception:
+        pass
+
+    # Strategy 3: regex fallback on body
+    try:
+        body = page.locator("body").inner_text()
+        found = sum(1 for ind in attr_indicators if ind.lower() in body.lower())
+        if found > 0:
+            return min(found, 15), "regex"
+    except Exception:
+        pass
+
+    sys.stderr.write("[gbp_scraper] atributos: all_strategies_failed\n")
+    return 0, "none"
+
