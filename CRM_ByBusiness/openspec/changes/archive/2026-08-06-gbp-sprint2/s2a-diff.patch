+def _extract_horarios(page):
+    """Multi-fallback horarios extraction. Returns (dias_cubiertos, strategy_used)."""
+    day_names = [
+        "lunes", "martes", "mi\xc3\xa9rcoles", "jueves", "viernes", "s\xc3\xa1bado", "domingo",
+        "lun", "mar", "mi\xc3\xa9", "jue", "vie", "s\xc3\xa1b", "dom",
+        "mon", "tue", "wed", "thu", "fri", "sat", "sun",
+        "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday",
+    ]
+
+    # Strategy 1: table.WgFkxc (new 2026 DOM)
+    try:
+        tbl = page.locator("table.WgFkxc")
+        if tbl.count() > 0 and tbl.first.is_visible(timeout=3000):
+            txt = tbl.first.inner_text(timeout=3000)
+            found = sum(1 for d in day_names if d.lower() in txt.lower())
+            if found >= 3:
+                return min(found, 7), "css"
+    except Exception:
+        pass
+
+    # Strategy 2: table.eK4R0e (old selector, kept for backward compat)
+    try:
+        tbl = page.locator("table.eK4R0e")
+        if tbl.count() > 0 and tbl.first.is_visible(timeout=3000):
+            txt = tbl.first.inner_text(timeout=3000)
+            found = sum(1 for d in day_names if d.lower() in txt.lower())
+            if found >= 3:
+                return min(found, 7), "css"
+    except Exception:
+        pass
+
+    # Strategy 3: body text
+    try:
+        body = page.locator("body").inner_text()
+        found = sum(1 for d in day_names if d.lower() in body.lower())
+        if found >= 3:
+            return min(found, 7), "regex"
+    except Exception:
+        pass
+
+    sys.stderr.write("[gbp_scraper] horarios: all_strategies_failed\n")
+    return 0, "none"
+
